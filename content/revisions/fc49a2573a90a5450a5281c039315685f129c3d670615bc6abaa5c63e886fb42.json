  "challenge": "C-003",
  "task": "Return the length of the longest contiguous run of equal integers.\n\nImplement `int longest_run(const int *values, size_t count)`. Empty input returns 0. Values are between -10000 and 10000; there are at most 200 values. Do not change the input.\n\n## Examples\n\nInput: `[4, 4, 2, 2, 2, 4]` → output: `3`.\nInput: `[]` → output: `0`.\n",
  "language": "c",
  "file": "longest_run.c",
  "starter": "// TODO: implement the task.\n#include <stddef.h>\nint longest_run(const int *values, size_t count) { return 0; }\n",
  "entrypoint": "longest_run",
  "adapter": "#include \"mm_json.h\"\n#include <stdlib.h>\nint longest_run(const int *, size_t);\nmm_value *mm_call(const mm_value *args) {\n    const mm_value *list = mm_at(args, 0);\n    size_t n = mm_length(list);\n    int *a = calloc(n + 1, sizeof(int));\n    int *out = calloc(n + 1, sizeof(int));\n    for (size_t i = 0; i < n; i++)\n        a[i] = (int)mm_integer(mm_at(list, i));\n    return mm_new_integer(longest_run(a, n));\n}\n",
