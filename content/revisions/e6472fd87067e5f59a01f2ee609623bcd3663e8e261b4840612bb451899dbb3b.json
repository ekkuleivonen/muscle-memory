{
  "challenge": "HTML-001",
  "task": "The category page's filter form has two checkboxes, `in-stock` and `on-sale`, with bare text next to them. The accessibility audit flagged them: screen readers announce \"checkbox\" and nothing else, and clicking the text does not toggle the box.\n\nTie each checkbox to a label:\n\n- Give each checkbox the id `filter-NAME`, where NAME is its `name`: `filter-in-stock` and `filter-on-sale`.\n- Give each checkbox a `<label for=\"filter-NAME\">` whose text is exactly its name.\n- Keep both checkboxes, in the same order, with their `type` and `name` attributes, and keep everything inside the one `<form>`. The page has no other checkboxes or labels.\n\nEach check runs a CSS selector against the page and reads something from the matching elements, in document order: their `count`, their `text`, their accessible `label`, or an attribute such as `name` or `id`.\n",
  "language": "html",
  "file": "templates/filter-form-labels.html",
  "starter": "<!--\n  Product filters on the category page. The accessibility audit flagged these\n  checkboxes: each needs a label tied to it.\n-->\n<form>\n  <input type=\"checkbox\" name=\"in-stock\"> in-stock\n  <input type=\"checkbox\" name=\"on-sale\"> on-sale\n</form>\n",
  "entrypoint": "page",
  "parameters": [
    "selector",
    "read"
  ],
  "cases": [
    {
      "id": "case-1",
      "input": [
        "form input[type=checkbox]",
        "name"
      ],
      "expected": [
        "in-stock",
        "on-sale"
      ],
      "hidden": false
    },
    {
      "id": "case-2",
      "input": [
        "form input[type=checkbox]",
        "id"
      ],
      "expected": [
        "filter-in-stock",
        "filter-on-sale"
      ],
      "hidden": false
    },
    {
      "id": "case-3",
      "input": [
        "form input[type=checkbox]",
        "label"
      ],
      "expected": [
        "in-stock",
        "on-sale"
      ],
      "hidden": false
    },
    {
      "id": "case-4",
      "input": [
        "form label",
        "text"
      ],
      "expected": [
        "in-stock",
        "on-sale"
      ],
      "hidden": false
    },
    {
      "id": "case-5",
      "input": [
        "form",
        "count"
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "id": "case-6",
      "input": [
        "input[type=checkbox]",
        "count"
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "id": "case-7",
      "input": [
        "label",
        "count"
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "id": "case-8",
      "input": [
        "form input[type=checkbox]",
        "type"
      ],
      "expected": [
        "checkbox",
        "checkbox"
      ],
      "hidden": true
    },
    {
      "id": "case-9",
      "input": [
        "form label",
        "for"
      ],
      "expected": [
        "filter-in-stock",
        "filter-on-sale"
      ],
      "hidden": true
    },
    {
      "id": "case-10",
      "input": [
        "#filter-in-stock",
        "name"
      ],
      "expected": [
        "in-stock"
      ],
      "hidden": true
    },
    {
      "id": "case-11",
      "input": [
        "#filter-on-sale",
        "name"
      ],
      "expected": [
        "on-sale"
      ],
      "hidden": true
    },
    {
      "id": "case-12",
      "input": [
        "#filter-in-stock",
        "label"
      ],
      "expected": [
        "in-stock"
      ],
      "hidden": true
    },
    {
      "id": "case-13",
      "input": [
        "#filter-on-sale",
        "label"
      ],
      "expected": [
        "on-sale"
      ],
      "hidden": true
    },
    {
      "id": "case-14",
      "input": [
        "label[for=filter-in-stock]",
        "text"
      ],
      "expected": [
        "in-stock"
      ],
      "hidden": true
    },
    {
      "id": "case-15",
      "input": [
        "label[for=filter-on-sale]",
        "text"
      ],
      "expected": [
        "on-sale"
      ],
      "hidden": true
    },
    {
      "id": "case-16",
      "input": [
        "form #filter-in-stock, form #filter-on-sale",
        "count"
      ],
      "expected": 2,
      "hidden": true
    }
  ],
  "rules": []
}
