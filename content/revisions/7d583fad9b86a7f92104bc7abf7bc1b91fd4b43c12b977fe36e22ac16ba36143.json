{
  "challenge": "CPP-004",
  "task": "Return a new sequence rotated to the right by k positions.\n\nImplement `std::vector<int> rotate_right(const std::vector<int>& values, int k)`. k is 0..10000 and may exceed the length. Empty input stays empty; preserve duplicates and do not change the input. At most 100 integers, each in -10000..10000.\n\n## Examples\n\nInput: `[[1, 2, 3, 4], 1]` → output: `[4, 1, 2, 3]`.\nInput: `[[], 7]` → output: `[]`.\n",
  "language": "cpp",
  "file": "rotate.cpp",
  "starter": "// TODO: implement the task.\n#include <vector>\nstd::vector<int> rotate_right(const std::vector<int> &values, int k) { return values; }\n",
  "entrypoint": "rotate_right",
  "parameters": [
    "values",
    "k"
  ],
  "adapter": "#include \"mm_json.h\"\n#include <string>\n#include <vector>\nstd::vector<int> rotate_right(const std::vector<int> &, int);\nmm_value *mm_call(const mm_value *args) {\n    std::vector<int> a;\n    const mm_value *l = mm_at(args, 0);\n    for (size_t i = 0; i < mm_length(l); i++)\n        a.push_back((int)mm_integer(mm_at(l, i)));\n    mm_value *r = mm_new_array();\n    for (int x : rotate_right(a, (int)mm_integer(mm_at(args, 1))))\n        mm_push(r, mm_new_integer(x));\n    return r;\n}\n",
