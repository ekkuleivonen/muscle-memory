{
  "name": "muscle-memory",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run check:content && npm run build --workspace apps/web",
    "test": "node --import tsx --test packages/*/*.test.ts apps/web/app/*/*.test.ts apps/web/lib/*.test.ts",
    "check:content": "node --import tsx tools/build-content.ts --check",
    "build:content": "node --import tsx tools/build-content.ts",
    "build:cloudflare": "npm run build:cloudflare --workspace apps/web",
    "build:logo": "node tools/build-logo.mjs",
    "test:browser": "node tools/browser/sandbox-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.6",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "wrangler": "4.152.0"
  },
  "type": "module"
}
