{
  "name": "muscle-memory",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run check:content && npm run build --workspace apps/web",
    "test": "node --test tools/tests/*.test.mjs && node --experimental-sqlite --import tsx --test packages/*/*.test.ts apps/web/app/*/*.test.ts apps/web/lib/*.test.ts",
    "check:content": "node tools/content-check.mjs && node --import tsx tools/build-reference-catalog.ts --check && node --import tsx tools/build-demo-catalog.ts --check",
    "build:cloudflare": "npm run build:cloudflare --workspace apps/web",
    "demo:events": "node --experimental-sqlite --import tsx tools/reference-events.ts",
    "demo:evidence": "node --experimental-sqlite --import tsx tools/reference-evidence.ts",
    "delete:participant": "node --experimental-sqlite --import tsx tools/delete-participant.ts",
    "demo:authoring": "node --import tsx tools/authoring/cli.ts demo",
    "build:reference-catalog": "node --import tsx tools/build-reference-catalog.ts",
    "build:logo": "node tools/build-logo.mjs",
    "build:demo-catalog": "node --import tsx tools/build-demo-catalog.ts",
    "test:browser": "node tools/browser/sandbox-check.mjs && node tools/browser/workspace-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "wrangler": "4.152.0"
  },
  "type": "module"
}
