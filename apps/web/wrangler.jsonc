{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "muscle-memory",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "musclememory.run", "custom_domain": true }],
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Public verification metadata for the separately approved /admin* Access app.
  // These are not credentials; assertions are verified against the team's JWKS.
  "vars": {
    "CATALOG_MODE": "managed",
    "ADMIN_ACCESS_ISSUER": "https://elei.cloudflareaccess.com",
    "ADMIN_ACCESS_AUD": "147a7760861e051b94b0c5035288fdddcb301afa47d7973527127deeda3e2c4e",
    // ENG-376: human comparisons, built on demand into the private CONTENT cache (≤1 hour).
    "HUMAN_SUMMARY_CACHE_ENABLED": "true",
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "muscle-memory-catalog",
      "database_id": "30916af3-46a7-451c-b0d3-92570e090329",
    },
  ],
  "r2_buckets": [
    { "binding": "CONTENT", "bucket_name": "muscle-memory-content" },
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "muscle-memory" },
    // ENG-340: owner-approved verification-only RPC; SQL credential stays in web.
    { "binding": "PARTICIPANT_OWNER", "service": "muscle-memory-ingest", "entrypoint": "ParticipantOwner" },
    // ENG-376: owner-approved bounded eligibility checks (check ≤100 IDs, generation, authorize); no storage access.
    { "binding": "COMPARISON_ELIGIBILITY", "service": "muscle-memory-ingest", "entrypoint": "ComparisonEligibility" },
  ],
}
